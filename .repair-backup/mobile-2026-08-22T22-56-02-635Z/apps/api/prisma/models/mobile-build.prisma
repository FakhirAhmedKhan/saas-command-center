enum MobileBuildSource {
  GITHUB_ACTIONS
}

enum MobileBuildStatus {
  QUEUED
  BUILDING
  SUCCESS
  FAILED
  CANCELLED
}

model MobileBuild {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  mobileAppId  String @map("mobile_app_id") @db.Uuid
  repositoryId String @map("repository_id") @db.Uuid

  workflowRunId String            @map("workflow_run_id") @db.VarChar(128)
  source        MobileBuildSource @default(GITHUB_ACTIONS)

  commitSha String @map("commit_sha") @db.VarChar(64)
  branch    String @db.VarChar(255)

  version     String? @db.VarChar(64)
  buildNumber String? @map("build_number") @db.VarChar(64)

  platform MobilePlatform
  status   MobileBuildStatus @default(QUEUED)

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs  Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  releases MobileRelease[]

  @@unique([repositoryId, workflowRunId])
  @@index([workspaceId, mobileAppId])
  @@index([mobileAppId, createdAt(sort: Desc)])
  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([status])
  @@index([platform])
  @@map("mobile_builds")
}
