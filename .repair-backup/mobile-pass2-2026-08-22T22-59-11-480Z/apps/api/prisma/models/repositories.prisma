model PersonalGithubConnectIntent {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  installStateHash String    @unique @map("install_state_hash") @db.VarChar(64)
  oauthStateHash   String?   @unique @map("oauth_state_hash") @db.VarChar(64)
  pkceVerifier     String?   @map("pkce_verifier") @db.VarChar(128)
  installationId   String?   @map("installation_id") @db.VarChar(32)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_github_connect_intents")
}

model RepositoryConnectIntent {
  id               String    @id @default(uuid()) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  installStateHash String    @unique @map("install_state_hash") @db.VarChar(64)
  oauthStateHash   String?   @unique @map("oauth_state_hash") @db.VarChar(64)
  pkceVerifier     String?   @map("pkce_verifier") @db.VarChar(128)
  installationId   String?   @map("installation_id") @db.VarChar(32)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId])
  @@index([expiresAt])
  @@map("repository_connect_intents")
}

model RepositoryInstallation {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  provider               RepositoryProvider @default(GITHUB)
  externalInstallationId String             @map("external_installation_id") @db.VarChar(32)
  accountLogin           String             @map("account_login") @db.VarChar(255)
  accountType            String             @map("account_type") @db.VarChar(64)
  connectedById          String?            @map("connected_by_id") @db.Uuid
  connectedAt            DateTime           @default(now()) @map("connected_at") @db.Timestamptz(6)
  lastSyncedAt           DateTime?          @map("last_synced_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  repositories RepositoryConnection[]

  @@unique([workspaceId, provider, externalInstallationId])
  @@index([externalInstallationId])
  @@index([workspaceId, provider])
  @@map("repository_installations")
}

model RepositoryConnection {
  id             String             @id @default(uuid()) @db.Uuid
  workspaceId    String             @map("workspace_id") @db.Uuid
  installationId String             @map("installation_id") @db.Uuid
  applicationId  String?            @map("application_id") @db.Uuid
  provider       RepositoryProvider @default(GITHUB)
  externalRepoId String             @map("external_repo_id") @db.VarChar(32)

  owner         String  @db.VarChar(255)
  name          String  @db.VarChar(255)
  fullName      String  @map("full_name") @db.VarChar(512)
  defaultBranch String  @map("default_branch") @db.VarChar(255)
  isPrivate     Boolean @map("is_private")
  htmlUrl       String  @map("html_url") @db.VarChar(2048)
  archived      Boolean @default(false)
  isAvailable   Boolean @default(true) @map("is_available")

  lastSyncedAt DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation RepositoryInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  application  SaasApplication?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  mobileBuilds MobileBuild[]

  @@unique([workspaceId, provider, externalRepoId])
  @@index([workspaceId, isAvailable])
  @@index([installationId])
  @@index([workspaceId, applicationId])
  @@map("repository_connections")
}

model RepositoryWebhookDelivery {
  id                     String    @id @default(uuid()) @db.Uuid
  deliveryId             String    @unique @map("delivery_id") @db.VarChar(100)
  event                  String    @db.VarChar(100)
  action                 String?   @db.VarChar(100)
  externalInstallationId String?   @map("external_installation_id") @db.VarChar(32)
  externalRepoId         String?   @map("external_repo_id") @db.VarChar(32)
  processedAt            DateTime? @map("processed_at") @db.Timestamptz(6)
  errorMessage           String?   @map("error_message") @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([externalInstallationId])
  @@index([externalRepoId])
  @@index([createdAt(sort: Desc)])
  @@map("repository_webhook_deliveries")
}
