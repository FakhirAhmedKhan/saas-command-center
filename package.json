{
  "name": "saas-command-center",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build:packages": "pnpm --filter @command-center/shared-types build",
    "build": "pnpm build:packages && pnpm -r --if-present build && pnpm size",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck",
    "test": "pnpm run test:all",
    "test:api": "pnpm --filter @command-center/api-tests test",
    "test:tracker": "pnpm --filter @command-center/tracker-tests test",
    "test:web": "pnpm --filter @command-center/web-tests test",
    "test:web:fullstack": "pnpm --filter @command-center/web-tests test:fullstack",
    "test:all": "node -e \"const{spawnSync}=require('node:child_process');const steps=[['API','test:api'],['Tracker','test:tracker'],['Web','test:web']];const results=[];for(const[label,script]of steps){console.log();console.log('====================================');console.log(label.toUpperCase()+' TESTS');console.log('====================================');console.log();const r=spawnSync('pnpm',['run',script],{stdio:'inherit',shell:true});const pass=(r.status===0);results.push([label,pass]);console.log();console.log(label+': '+(pass?'PASS':'FAIL'));}console.log();console.log('====================================');console.log('FINAL TEST SUMMARY');console.log('====================================');for(const[label,pass]of results){console.log(label.padEnd(9)+(pass?'PASS':'FAIL'));}const overallPass=results.every(function(x){return x[1]});console.log();console.log('Overall: '+(overallPass?'PASS':'FAIL'));process.exit(overallPass?0:1);\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose -f infrastructure/docker-compose.yml up -d",
    "db:down": "docker compose -f infrastructure/docker-compose.yml down",
    "db:logs": "docker compose -f infrastructure/docker-compose.yml logs -f",
    "db:status": "docker compose -f infrastructure/docker-compose.yml ps",
    "dev": "concurrently -k --names API,WEB,TRACKER --prefix-colors cyan.bold,magenta.bold,yellow.bold --prefix \"[{name}]\" \"pnpm run dev:api\" \"pnpm run dev:web\" \"pnpm run dev:tracker\"",
    "dev:api": "pnpm --filter @command-center/api start:dev",
    "dev:web": "pnpm --filter @command-center/web dev",
    "dev:tracker": "pnpm --filter @command-center/tracker dev",
    "style:fix": "pnpm lint:fix && pnpm format",
    "size": "node scripts/build-size-report.mjs",
    "analyze:web": "pnpm --filter @command-center/web exec next experimental-analyze"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
