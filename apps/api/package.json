{
    "name": "@command-center/api",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "prisma:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "prisma db seed",
        "db:reset": "prisma migrate reset",
        "db:studio": "prisma studio",
        "test:e2e": "jest --config ./test/jest-e2e.config.cjs --runInBand",
        "test:e2e:watch": "jest --config ./test/jest-e2e.config.cjs --runInBand --watch",
        "test:e2e:auth": "jest --config ./test/jest-e2e.config.cjs --runInBand auth.e2e-spec.ts",
        "test:e2e:workspaces": "jest --config ./test/jest-e2e.config.cjs --runInBand workspaces.e2e-spec.ts",
        "test:e2e:coverage": "jest --config ./test/jest-e2e.config.cjs --runInBand --coverage",
