    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "demo:seed": "prisma generate && tsx scripts/demo-data.ts seed",
    "demo:reset": "prisma generate && tsx scripts/demo-data.ts reset",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
