        "luxon": "^3.7.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.22.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.34.0",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.7",
        "@nestjs/testing": "^11.1.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.3",
        "@types/jest": "29.5.14",
        "@types/luxon": "^3.7.3",
        "@types/node": "^24.3.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/pg": "^8.20.3",
        "@types/supertest": "^6.0.3",
        "cross-env": "^10.1.0",
        "eslint": "^9.34.0",
        "jest": "29.7.0",
        "prisma": "7.9.1",
        "source-map-support": "^0.5.21",
        "supertest": "^7.1.4",
        "ts-jest": "29.4.12",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.23.1",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.41.0"
    }
