        "test:e2e:analytics-ingestion-security": "jest --config ./test/jest-e2e.config.cjs --runInBand analytics-ingestion-security.e2e-spec.ts",
        "test:e2e:analytics-ingestion-rate-limit": "jest --config ./test/jest-e2e.config.cjs --runInBand analytics-ingestion-rate-limit.e2e-spec.ts",
        "test:e2e:tracking-admin": "jest --config ./test/jest-e2e.config.cjs --runInBand tracking-admin.e2e-spec.ts",
        "test:e2e:raw-events": "jest --config ./test/jest-e2e.config.cjs --runInBand raw-events.e2e-spec.ts",
