        "test:e2e:analytics-engine-processing": "jest --config ./test/jest-e2e.config.cjs --runInBand analytics-engine-processing.e2e-spec.ts",
        "test:e2e:analytics-visitors": "jest --config ./test/jest-e2e.config.cjs --runInBand analytics-visitors.e2e-spec.ts",
        "test:e2e:analytics-sessions": "jest --config ./test/jest-e2e.config.cjs --runInBand analytics-sessions.e2e-spec.ts",
        "test:e2e:analytics-pageviews": "jest --config ./test/jest-e2e.config.cjs --runInBand analytics-pageviews.e2e-spec.ts"
