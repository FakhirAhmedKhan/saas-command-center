        "test:e2e:technologies": "jest --config ./test/jest-e2e.config.cjs --runInBand application-technologies.e2e-spec.ts",
        "test:e2e:development-activity": "jest --config ./test/jest-e2e.config.cjs --runInBand development-activity.e2e-spec.ts",
