{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": [
    "<rootDir>/test/setup-env.ts"
  ],
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/generated/**",
    "!src/**/*.module.ts"
  ],
  "coverageDirectory": "<rootDir>/coverage/e2e",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "detectOpenHandles": true,
  "forceExit": false
}