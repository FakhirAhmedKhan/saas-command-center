generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(120)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  ownedWorkspaces             Workspace[]           @relation("WorkspaceOwner")
  memberships                 WorkspaceMember[]
  authSessions                AuthSession[]
  applicationActivities       ApplicationActivity[] @relation("ApplicationActivityActor")
  assignedApplicationTasks    ApplicationTask[]     @relation("ApplicationTaskAssignee")
  createdApplicationBlockers  ApplicationBlocker[]  @relation("ApplicationBlockerCreator")
  resolvedApplicationBlockers ApplicationBlocker[]  @relation("ApplicationBlockerResolver")

  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(120)
  ownerId   String    @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner                 User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members               WorkspaceMember[]
  saasApplications      SaasApplication[]
  applicationActivities ApplicationActivity[]
  websites              Website[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  parentSessionId  String?   @unique @map("parent_session_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentSession  AuthSession? @relation("AuthSessionRotation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  rotatedSession AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum ApplicationStatus {
  IDEA
  PLANNING
  IN_DEVELOPMENT
  TESTING
  LIVE
  MAINTENANCE
  PAUSED
}

enum ApplicationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApplicationCategory {
  SAAS
  AI
  MOBILE
  ECOMMERCE
  API
  INTERNAL_TOOL
  OTHER
}

enum TechnologyType {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  AI
  INFRASTRUCTURE
  OTHER
}

enum ApplicationLinkType {
  PRODUCTION
  STAGING
  REPOSITORY
  DOCUMENTATION
  DESIGN
  API
  OTHER
}

model SaasApplication {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  name             String              @db.VarChar(160)
  slug             String              @db.VarChar(160)
  shortDescription String?             @map("short_description") @db.VarChar(280)
  longDescription  String?             @map("long_description") @db.Text
  category         ApplicationCategory @default(SAAS)
  status           ApplicationStatus   @default(IDEA)
  priority         ApplicationPriority @default(MEDIUM)
  startedAt        DateTime?           @map("started_at")
  targetLaunchAt   DateTime?           @map("target_launch_at")
  launchedAt       DateTime?           @map("launched_at")
  lastActivityAt   DateTime?           @map("last_activity_at")
  archivedAt       DateTime?           @map("archived_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  technologies ApplicationTechnology[]
  links        ApplicationLink[]
  activities   ApplicationActivity[]
  websites     Website[]

  progressPercent     Int                      @default(0) @map("progress_percent")
  progressUpdatedAt   DateTime?                @map("progress_updated_at")
  developmentTemplate DevelopmentTemplateType? @map("development_template")
  templateAppliedAt   DateTime?                @map("template_applied_at")

  milestones ApplicationMilestone[]
  blockers   ApplicationBlocker[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@map("saas_applications")
}

model ApplicationMilestone {
  id              String          @id @default(uuid()) @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  title           String          @db.VarChar(160)
  description     String?         @db.Text
  status          MilestoneStatus @default(PLANNED)
  weight          Int             @default(1)
  position        Int             @default(0)
  progressPercent Int             @default(0) @map("progress_percent")
  startsAt        DateTime?       @map("starts_at")
  dueAt           DateTime?       @map("due_at")
  completedAt     DateTime?       @map("completed_at")
  skippedAt       DateTime?       @map("skipped_at")
  skipReason      String?         @map("skip_reason") @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  application SaasApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tasks       ApplicationTask[]
  blockers    ApplicationBlocker[]

  @@index([applicationId, position])
  @@index([applicationId, status])
  @@index([applicationId, dueAt])
  @@map("application_milestones")
}

model ApplicationTask {
  id             String                @id @default(uuid()) @db.Uuid
  milestoneId    String                @map("milestone_id") @db.Uuid
  assigneeUserId String?               @map("assignee_user_id") @db.Uuid
  title          String                @db.VarChar(200)
  description    String?               @db.Text
  status         ApplicationTaskStatus @default(TODO)
  priority       WorkItemPriority      @default(MEDIUM)
  weight         Int                   @default(1)
  position       Int                   @default(0)
  dueAt          DateTime?             @map("due_at")
  completedAt    DateTime?             @map("completed_at")
  skippedAt      DateTime?             @map("skipped_at")
  skipReason     String?               @map("skip_reason") @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  milestone ApplicationMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignee  User?                @relation("ApplicationTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  blockers  ApplicationBlocker[]

  @@index([milestoneId, position])
  @@index([milestoneId, status])
  @@index([assigneeUserId])
  @@index([dueAt, status])
  @@map("application_tasks")
}

model ApplicationBlocker {
  id               String           @id @default(uuid()) @db.Uuid
  applicationId    String           @map("application_id") @db.Uuid
  milestoneId      String?          @map("milestone_id") @db.Uuid
  taskId           String?          @map("task_id") @db.Uuid
  createdByUserId  String?          @map("created_by_user_id") @db.Uuid
  resolvedByUserId String?          @map("resolved_by_user_id") @db.Uuid
  title            String           @db.VarChar(200)
  description      String?          @db.Text
  severity         WorkItemPriority @default(HIGH)
  status           BlockerStatus    @default(OPEN)
  openedAt         DateTime         @default(now()) @map("opened_at")
  resolvedAt       DateTime?        @map("resolved_at")
  resolution       String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  application SaasApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  milestone   ApplicationMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task        ApplicationTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdBy  User? @relation("ApplicationBlockerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ApplicationBlockerResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, status])
  @@index([applicationId, severity])
  @@index([milestoneId])
  @@index([taskId])
  @@index([openedAt])
  @@map("application_blockers")
}

model Website {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  applicationId        String?   @map("application_id") @db.Uuid
  name                 String    @db.VarChar(160)
  domain               String    @db.VarChar(253)
  timeZone             String    @default("UTC") @map("time_zone") @db.VarChar(64)
  enabled              Boolean   @default(true)
  allowedOrigins       String[]  @default([]) @map("allowed_origins")
  trackingKeyPrefix    String    @unique @map("tracking_key_prefix") @db.VarChar(32)
  trackingKeyHash      String    @unique @map("tracking_key_hash") @db.VarChar(64)
  trackingKeyRotatedAt DateTime  @default(now()) @map("tracking_key_rotated_at")
  lastEventAt          DateTime? @map("last_event_at")
  archivedAt           DateTime? @map("archived_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application SaasApplication?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  rawEvents   RawAnalyticsEvent[]

  @@unique([workspaceId, domain])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, enabled])
  @@index([workspaceId, applicationId])
  @@index([applicationId])
  @@index([lastEventAt])
  @@map("websites")
}

model RawAnalyticsEvent {
  id             String                @id @default(uuid()) @db.Uuid
  websiteId      String                @map("website_id") @db.Uuid
  eventId        String                @map("event_id") @db.VarChar(80)
  type           RawAnalyticsEventType
  visitorId      String                @map("visitor_id") @db.VarChar(80)
  sessionId      String                @map("session_id") @db.VarChar(80)
  occurredAt     DateTime              @map("occurred_at")
  receivedAt     DateTime              @default(now()) @map("received_at")
  pageUrl        String                @map("page_url") @db.VarChar(2048)
  pagePath       String                @map("page_path") @db.VarChar(2048)
  pageTitle      String?               @map("page_title") @db.VarChar(512)
  referrerUrl    String?               @map("referrer_url") @db.VarChar(2048)
  eventName      String?               @map("event_name") @db.VarChar(100)
  properties     Json?
  screenWidth    Int?                  @map("screen_width")
  screenHeight   Int?                  @map("screen_height")
  viewportWidth  Int?                  @map("viewport_width")
  viewportHeight Int?                  @map("viewport_height")
  language       String?               @db.VarChar(35)
  clientTimeZone String?               @map("client_time_zone") @db.VarChar(64)
  durationMs     Int?                  @map("duration_ms")
  origin         String                @db.VarChar(512)
  userAgent      String?               @map("user_agent") @db.VarChar(512)
  ipHash         String?               @map("ip_hash") @db.VarChar(64)
  sdkVersion     String                @map("sdk_version") @db.VarChar(32)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, eventId])
  @@index([websiteId, receivedAt])
  @@index([websiteId, occurredAt])
  @@index([websiteId, type, occurredAt])
  @@index([websiteId, visitorId, occurredAt])
  @@index([websiteId, sessionId, occurredAt])
  @@index([eventName])
  @@map("raw_analytics_events")
}

model ApplicationTechnology {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  name          String         @db.VarChar(80)
  type          TechnologyType
  version       String?        @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  application SaasApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name, type])
  @@index([applicationId, type])
  @@map("application_technologies")
}

model ApplicationLink {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  label         String              @db.VarChar(80)
  type          ApplicationLinkType
  url           String              @db.VarChar(2048)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  application SaasApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, url])
  @@index([applicationId, type])
  @@map("application_links")
}

enum ActivityActorType {
  USER
  SYSTEM
}

enum ActivityEntityType {
  APPLICATION
  TECHNOLOGY
  LINK
  MILESTONE
  TASK
  BLOCKER
  WEBSITE
}

enum ApplicationActivityType {
  APPLICATION_CREATED
  APPLICATION_UPDATED
  APPLICATION_STATUS_CHANGED
  APPLICATION_PRIORITY_CHANGED
  APPLICATION_ARCHIVED
  APPLICATION_RESTORED
  APPLICATION_DELETED

  TECHNOLOGY_ADDED
  TECHNOLOGY_UPDATED
  TECHNOLOGY_REMOVED

  LINK_ADDED
  LINK_UPDATED
  LINK_REMOVED

  MILESTONE_CREATED
  MILESTONE_UPDATED
  MILESTONE_COMPLETED
  MILESTONE_REOPENED
  MILESTONE_SKIPPED
  MILESTONE_DELETED
  MILESTONE_REORDERED

  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_SKIPPED
  TASK_MOVED
  TASK_DELETED
  TASK_REORDERED

  BLOCKER_CREATED
  BLOCKER_UPDATED
  BLOCKER_RESOLVED
  BLOCKER_REOPENED
  BLOCKER_DELETED

  DEVELOPMENT_TEMPLATE_APPLIED

  WEBSITE_CREATED
  WEBSITE_UPDATED
  WEBSITE_ENABLED
  WEBSITE_DISABLED
  WEBSITE_ARCHIVED
  WEBSITE_RESTORED
  WEBSITE_TRACKING_KEY_ROTATED
  WEBSITE_CONNECTED
  WEBSITE_DISCONNECTED
}

model ApplicationActivity {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  applicationId   String?                 @map("application_id") @db.Uuid
  applicationName String                  @map("application_name") @db.VarChar(160)
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  actorType       ActivityActorType       @default(USER) @map("actor_type")
  activityType    ApplicationActivityType @map("activity_type")
  entityType      ActivityEntityType      @map("entity_type")
  entityId        String?                 @map("entity_id") @db.Uuid
  title           String                  @db.VarChar(180)
  description     String?                 @db.VarChar(500)
  metadata        Json?
  createdAt       DateTime                @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application SaasApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  actor       User?            @relation("ApplicationActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([workspaceId, activityType, createdAt])
  @@index([workspaceId, entityType, createdAt])
  @@map("application_activities")
}

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum ApplicationTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED
  SKIPPED
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlockerStatus {
  OPEN
  RESOLVED
}

enum DevelopmentTemplateType {
  STANDARD_SAAS
  AI_SAAS
  MOBILE
  API
  ECOMMERCE
}

enum RawAnalyticsEventType {
  PAGE_VIEW
  HEARTBEAT
  CUSTOM
}
