generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AnalyticsProcessingRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  DEAD_LETTERED
  CANCELLED
}

enum AnalyticsProcessingTrigger {
  SCHEDULED
  MANUAL
  RETRY
}

model AnalyticsProcessingRun {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @map("workspace_id") @db.Uuid
  websiteId     String  @map("website_id") @db.Uuid
  requestedById String? @map("requested_by_id") @db.Uuid

  trigger AnalyticsProcessingTrigger
  status  AnalyticsProcessingRunStatus @default(QUEUED)

  rangeStart DateTime @map("range_start") @db.Timestamptz(6)
  rangeEnd   DateTime @map("range_end") @db.Timestamptz(6)

  activeKey String? @unique @map("active_key")
  lockKey   String  @map("lock_key")

  retryCount    Int      @default(0) @map("retry_count")
  maxRetries    Int      @default(3) @map("max_retries")
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  pendingEventsAtStart Int @default(0) @map("pending_events_at_start")
  processedEvents      Int @default(0) @map("processed_events")
  failedEvents         Int @default(0) @map("failed_events")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message") @db.Text

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workspaceId, websiteId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([websiteId, status])
  @@map("analytics_processing_runs")
}

model AnalyticsProcessingDeadLetter {
  id          String @id @default(uuid()) @db.Uuid
  runId       String @unique @map("run_id") @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  websiteId   String @map("website_id") @db.Uuid

  rangeStart DateTime @map("range_start") @db.Timestamptz(6)
  rangeEnd   DateTime @map("range_end") @db.Timestamptz(6)

  retryCount   Int     @map("retry_count")
  errorCode    String? @map("error_code")
  errorMessage String  @map("error_message") @db.Text

  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedById String?   @map("resolved_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([websiteId, resolvedAt, createdAt(sort: Desc)])
  @@map("analytics_processing_dead_letters")
}

enum HealthTargetType {
  APPLICATION
  WEBSITE
}

enum HealthCheckStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  DOWN
  DISABLED
}

enum HealthIncidentStatus {
  OPEN
  RESOLVED
}

model HealthCheck {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  targetType    HealthTargetType @map("target_type")
  applicationId String?          @map("application_id") @db.Uuid
  websiteId     String?          @map("website_id") @db.Uuid

  name String
  url  String @db.Text

  intervalSeconds Int @default(300) @map("interval_seconds")
  timeoutMs       Int @default(10000) @map("timeout_ms")

  expectedStatusMin Int @default(200) @map("expected_status_min")
  expectedStatusMax Int @default(399) @map("expected_status_max")

  degradedAfterMs Int @default(1500) @map("degraded_after_ms")

  failureThreshold Int @default(3) @map("failure_threshold")

  enabled Boolean @default(true)

  latestStatus HealthCheckStatus @default(UNKNOWN) @map("latest_status")

  lastStatusCode     Int?    @map("last_status_code")
  lastResponseTimeMs Int?    @map("last_response_time_ms")
  lastFailureReason  String? @map("last_failure_reason") @db.Text

  consecutiveFailures Int @default(0) @map("consecutive_failures")

  lastCheckedAt    DateTime? @map("last_checked_at") @db.Timestamptz(6)
  lastSuccessfulAt DateTime? @map("last_successful_at") @db.Timestamptz(6)
  nextRunAt        DateTime  @default(now()) @map("next_run_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  website     Website?     @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  history   HealthCheckHistory[]
  incidents HealthIncident[]

  @@index([workspaceId, latestStatus])
  @@index([workspaceId, enabled])
  @@index([enabled, nextRunAt])
  @@index([applicationId])
  @@index([websiteId])
  @@map("health_checks")
}

model HealthCheckHistory {
  id            String @id @default(uuid()) @db.Uuid
  healthCheckId String @map("health_check_id") @db.Uuid

  status HealthCheckStatus

  statusCode     Int?    @map("status_code")
  responseTimeMs Int?    @map("response_time_ms")
  failureReason  String? @map("failure_reason") @db.Text

  checkedAt DateTime @default(now()) @map("checked_at") @db.Timestamptz(6)

  healthCheck HealthCheck @relation(fields: [healthCheckId], references: [id], onDelete: Cascade)

  @@index([healthCheckId, checkedAt(sort: Desc)])
  @@index([checkedAt])
  @@map("health_check_history")
}

model HealthIncident {
  id            String @id @default(uuid()) @db.Uuid
  healthCheckId String @map("health_check_id") @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid

  status HealthIncidentStatus @default(OPEN)

  activeKey String? @unique @map("active_key")

  summary      String
  failureCount Int    @default(1) @map("failure_count")

  firstFailureAt DateTime @map("first_failure_at") @db.Timestamptz(6)
  lastFailureAt  DateTime @map("last_failure_at") @db.Timestamptz(6)

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  healthCheck HealthCheck @relation(fields: [healthCheckId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, startedAt(sort: Desc)])
  @@index([healthCheckId, status])
  @@map("health_incidents")
}

enum ReleaseStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  SUCCESSFUL
  FAILED
  ROLLED_BACK
}

enum DeploymentStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  SUCCESSFUL
  FAILED
  ROLLED_BACK
}

enum DeploymentActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  ROLLBACK_RECORDED
  INCIDENT_LINKED
  INCIDENT_UNLINKED
}

model Release {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid

  version String
  name    String?
  notes   String? @db.Text

  commitRef     String? @map("commit_ref")
  repositoryUrl String? @map("repository_url") @db.Text

  status ReleaseStatus @default(DRAFT)

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  releasedAt  DateTime? @map("released_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  createdBy User @relation("ReleaseCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("ReleaseUpdatedBy", fields: [updatedById], references: [id])

  deployments Deployment[]

  @@unique([applicationId, version])
  @@index([workspaceId, applicationId, createdAt(sort: Desc)])
  @@index([applicationId, status])
  @@map("releases")
}

model Deployment {
  id            String @id @default(uuid()) @db.Uuid
  workspaceId   String @map("workspace_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  environmentId String @map("environment_id") @db.Uuid
  releaseId     String @map("release_id") @db.Uuid

  attempt Int @default(1)

  status DeploymentStatus @default(DRAFT)

  commitRef String? @map("commit_ref")

  repositoryUrl String? @map("repository_url") @db.Text
  ciJobUrl      String? @map("ci_job_url") @db.Text
  liveUrl       String? @map("live_url") @db.Text

  deploymentNotes String? @map("deployment_notes") @db.Text
  failureReason   String? @map("failure_reason") @db.Text

  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  durationMs Int? @map("duration_ms")

  statusChangedAt DateTime @default(now()) @map("status_changed_at") @db.Timestamptz(6)

  deployedById String? @map("deployed_by_id") @db.Uuid
  createdById  String  @map("created_by_id") @db.Uuid
  updatedById  String  @map("updated_by_id") @db.Uuid

  rollbackToDeploymentId String? @map("rollback_to_deployment_id") @db.Uuid
  healthIncidentId       String? @map("health_incident_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application Application            @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  environment ApplicationEnvironment @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  release     Release                @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  deployedBy User? @relation("DeploymentDeployedBy", fields: [deployedById], references: [id])
  createdBy  User  @relation("DeploymentCreatedBy", fields: [createdById], references: [id])
  updatedBy  User  @relation("DeploymentUpdatedBy", fields: [updatedById], references: [id])

  rollbackTo         Deployment?  @relation("DeploymentRollback", fields: [rollbackToDeploymentId], references: [id], onDelete: SetNull)
  rollbackReferences Deployment[] @relation("DeploymentRollback")

  healthIncident HealthIncident? @relation(fields: [healthIncidentId], references: [id], onDelete: SetNull)

  activities DeploymentActivity[]

  @@unique([releaseId, environmentId, attempt])
  @@index([workspaceId, applicationId, createdAt(sort: Desc)])
  @@index([environmentId, statusChangedAt(sort: Desc)])
  @@index([applicationId, status])
  @@index([healthIncidentId])
  @@map("deployments")
}

model DeploymentActivity {
  id           String @id @default(uuid()) @db.Uuid
  workspaceId  String @map("workspace_id") @db.Uuid
  deploymentId String @map("deployment_id") @db.Uuid
  actorId      String @map("actor_id") @db.Uuid

  action DeploymentActivityAction

  fromStatus DeploymentStatus? @map("from_status")
  toStatus   DeploymentStatus? @map("to_status")

  message  String?
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  actor      User       @relation(fields: [actorId], references: [id])

  @@index([deploymentId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("deployment_activities")
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

enum InvitationDeliveryStatus {
  NOT_REQUESTED
  SENT
  FAILED
}

enum NotificationType {
  WORKSPACE_INVITATION
  WORKSPACE_INVITATION_ACCEPTED
  ASSIGNMENT
  DEPLOYMENT_FAILED
  HEALTH_INCIDENT_OPENED
  ANALYTICS_PROCESSING_FAILED
  SYSTEM
}

enum NotificationPriority {
  INFO
  WARNING
  CRITICAL
}

model WorkspaceInvitation {
  id           String  @id @default(uuid()) @db.Uuid
  workspaceId  String  @map("workspace_id") @db.Uuid
  invitedById  String  @map("invited_by_id") @db.Uuid
  acceptedById String? @map("accepted_by_id") @db.Uuid

  email String
  role  WorkspaceRole

  tokenHash String @unique @map("token_hash")

  status WorkspaceInvitationStatus @default(PENDING)

  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  declinedAt DateTime? @map("declined_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  lastSentAt DateTime? @map("last_sent_at") @db.Timestamptz(6)
  sendCount  Int       @default(0) @map("send_count")

  deliveryStatus InvitationDeliveryStatus @default(NOT_REQUESTED) @map("delivery_status")
  deliveryError  String?                  @map("delivery_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("WorkspaceInvitationInvitedBy", fields: [invitedById], references: [id])
  acceptedBy User?     @relation("WorkspaceInvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([email, status])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model Notification {
  id            String  @id @default(uuid()) @db.Uuid
  workspaceId   String  @map("workspace_id") @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  applicationId String? @map("application_id") @db.Uuid

  type     NotificationType
  priority NotificationPriority @default(INFO)

  title   String
  message String @db.Text

  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id") @db.Uuid

  actionUrl String? @map("action_url") @db.Text
  payload   Json?

  dedupeKey String? @map("dedupe_key")

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("notifications")
}

enum WebhookEventType {
  WEBHOOK_TEST

  APPLICATION_CREATED
  APPLICATION_UPDATED

  DEPLOYMENT_STATUS_CHANGED
  DEPLOYMENT_FAILED

  HEALTH_INCIDENT_OPENED
  HEALTH_INCIDENT_RESOLVED

  ANALYTICS_PROCESSING_FAILED

  WORKSPACE_ACTIVITY_CREATED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  SUCCEEDED
  DEAD_LETTERED
  CANCELLED
}

enum WebhookAttemptOutcome {
  SUCCEEDED
  FAILED
}

model WebhookEndpoint {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  name String
  url  String @db.Text

  eventTypes WebhookEventType[] @map("event_types")

  payloadVersion String @default("2026-08-01") @map("payload_version")

  secretCiphertext String @map("secret_ciphertext") @db.Text
  secretIv         String @map("secret_iv")
  secretAuthTag    String @map("secret_auth_tag")
  secretKeyVersion Int    @default(1) @map("secret_key_version")

  timeoutMs   Int @default(10000) @map("timeout_ms")
  maxAttempts Int @default(5) @map("max_attempts")

  enabled Boolean @default(true)

  lastDeliveryAt DateTime? @map("last_delivery_at") @db.Timestamptz(6)
  lastSuccessAt  DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureAt  DateTime? @map("last_failure_at") @db.Timestamptz(6)

  createdById String @map("created_by_id") @db.Uuid
  updatedById String @map("updated_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdBy User @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("WebhookEndpointUpdatedBy", fields: [updatedById], references: [id])

  deliveries WebhookDelivery[]

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
  @@map("webhook_endpoints")
}

model WebhookEvent {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  type           WebhookEventType
  payloadVersion String           @default("2026-08-01") @map("payload_version")

  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id") @db.Uuid

  payload Json

  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  @@index([workspaceId, type, occurredAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("webhook_events")
}

model WebhookDelivery {
  id          String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid

  endpointId String @map("endpoint_id") @db.Uuid
  eventId    String @map("event_id") @db.Uuid

  status WebhookDeliveryStatus @default(PENDING)

  attemptCount Int @default(0) @map("attempt_count")
  maxAttempts  Int @default(5) @map("max_attempts")

  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  responseStatus     Int? @map("response_status")
  responseDurationMs Int? @map("response_duration_ms")

  failureCode   String? @map("failure_code")
  failureReason String? @map("failure_reason") @db.Text

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event     WebhookEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  attempts WebhookDeliveryAttempt[]

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([endpointId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model WebhookDeliveryAttempt {
  id         String @id @default(uuid()) @db.Uuid
  deliveryId String @map("delivery_id") @db.Uuid

  attemptNumber Int @map("attempt_number")

  outcome WebhookAttemptOutcome

  responseStatus Int? @map("response_status")
  durationMs     Int  @map("duration_ms")

  errorCode    String? @map("error_code")
  errorMessage String? @map("error_message") @db.Text

  startedAt  DateTime @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime @map("finished_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, createdAt(sort: Desc)])
  @@map("webhook_delivery_attempts")
}

