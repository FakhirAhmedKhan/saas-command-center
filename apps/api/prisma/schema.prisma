generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(120)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  authSessions    AuthSession[]

  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(120)
  ownerId   String    @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members          WorkspaceMember[]
  saasApplications SaasApplication[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  parentSessionId  String?   @unique @map("parent_session_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentSession  AuthSession? @relation("AuthSessionRotation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  rotatedSession AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum ApplicationStatus {
  IDEA
  PLANNING
  IN_DEVELOPMENT
  TESTING
  LIVE
  MAINTENANCE
  PAUSED
}

enum ApplicationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApplicationCategory {
  SAAS
  AI
  MOBILE
  ECOMMERCE
  API
  INTERNAL_TOOL
  OTHER
}

enum TechnologyType {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  AI
  INFRASTRUCTURE
  OTHER
}

enum ApplicationLinkType {
  PRODUCTION
  STAGING
  REPOSITORY
  DOCUMENTATION
  DESIGN
  API
  OTHER
}

model SaasApplication {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  name             String              @db.VarChar(160)
  slug             String              @db.VarChar(160)
  shortDescription String?             @map("short_description") @db.VarChar(280)
  longDescription  String?             @map("long_description") @db.Text
  category         ApplicationCategory @default(SAAS)
  status           ApplicationStatus   @default(IDEA)
  priority         ApplicationPriority @default(MEDIUM)
  startedAt        DateTime?           @map("started_at")
  targetLaunchAt   DateTime?           @map("target_launch_at")
  launchedAt       DateTime?           @map("launched_at")
  lastActivityAt   DateTime?           @map("last_activity_at")
  archivedAt       DateTime?           @map("archived_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  technologies ApplicationTechnology[]
  links        ApplicationLink[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@map("saas_applications")
}

model ApplicationTechnology {
  id            String         @id @default(uuid()) @db.Uuid
  applicationId String         @map("application_id") @db.Uuid
  name          String         @db.VarChar(80)
  type          TechnologyType
  version       String?        @db.VarChar(50)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  application SaasApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, name, type])
  @@index([applicationId, type])
  @@map("application_technologies")
}

model ApplicationLink {
  id            String              @id @default(uuid()) @db.Uuid
  applicationId String              @map("application_id") @db.Uuid
  label         String              @db.VarChar(80)
  type          ApplicationLinkType
  url           String              @db.VarChar(2048)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  application SaasApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, url])
  @@index([applicationId, type])
  @@map("application_links")
}
