generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(120)
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  ownedWorkspaces             Workspace[]           @relation("WorkspaceOwner")
  memberships                 WorkspaceMember[]
  authSessions                AuthSession[]
  applicationActivities       ApplicationActivity[] @relation("ApplicationActivityActor")
  assignedApplicationTasks    ApplicationTask[]     @relation("ApplicationTaskAssignee")
  createdApplicationBlockers  ApplicationBlocker[]  @relation("ApplicationBlockerCreator")
  resolvedApplicationBlockers ApplicationBlocker[]  @relation("ApplicationBlockerResolver")

  @@index([deletedAt])
  @@index([isActive])
  @@map("users")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(120)
  ownerId   String    @map("owner_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner                 User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members               WorkspaceMember[]
  saasApplications      SaasApplication[]
  applicationActivities ApplicationActivity[]
  websites              Website[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now()) @map("joined_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @default(uuid()) @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(128)
  parentSessionId  String?   @unique @map("parent_session_id") @db.Uuid
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  revokeReason     String?   @map("revoke_reason") @db.VarChar(120)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentSession  AuthSession? @relation("AuthSessionRotation", fields: [parentSessionId], references: [id], onDelete: SetNull)
  rotatedSession AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

enum ApplicationStatus {
  IDEA
  PLANNING
  IN_DEVELOPMENT
  TESTING
  LIVE
  MAINTENANCE
  PAUSED
}

enum ApplicationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ApplicationCategory {
  SAAS
  AI
  MOBILE
  ECOMMERCE
  API
  INTERNAL_TOOL
  OTHER
}

enum TechnologyType {
  FRONTEND
  BACKEND
  DATABASE
  MOBILE
  AI
  INFRASTRUCTURE
  OTHER
}

enum ApplicationLinkType {
  PRODUCTION
  STAGING
  REPOSITORY
  DOCUMENTATION
  DESIGN
  API
  OTHER
}

model SaasApplication {
  id               String              @id @default(uuid()) @db.Uuid
  workspaceId      String              @map("workspace_id") @db.Uuid
  name             String              @db.VarChar(160)
  slug             String              @db.VarChar(160)
  shortDescription String?             @map("short_description") @db.VarChar(280)
  longDescription  String?             @map("long_description") @db.Text
  category         ApplicationCategory @default(SAAS)
  status           ApplicationStatus   @default(IDEA)
  priority         ApplicationPriority @default(MEDIUM)
  startedAt        DateTime?           @map("started_at")
  targetLaunchAt   DateTime?           @map("target_launch_at")
  launchedAt       DateTime?           @map("launched_at")
  lastActivityAt   DateTime?           @map("last_activity_at")
  archivedAt       DateTime?           @map("archived_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  technologies ApplicationTechnology[]
  links        ApplicationLink[]
  activities   ApplicationActivity[]
  websites     Website[]

  progressPercent     Int                      @default(0) @map("progress_percent")
  progressUpdatedAt   DateTime?                @map("progress_updated_at")
  developmentTemplate DevelopmentTemplateType? @map("development_template")
  templateAppliedAt   DateTime?                @map("template_applied_at")

  milestones ApplicationMilestone[]
  blockers   ApplicationBlocker[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
  @@map("saas_applications")
}

model ApplicationMilestone {
  id              String          @id @default(uuid()) @db.Uuid
  applicationId   String          @map("application_id") @db.Uuid
  title           String          @db.VarChar(160)
  description     String?         @db.Text
  status          MilestoneStatus @default(PLANNED)
  weight          Int             @default(1)
  position        Int             @default(0)
  progressPercent Int             @default(0) @map("progress_percent")
  startsAt        DateTime?       @map("starts_at")
  dueAt           DateTime?       @map("due_at")
  completedAt     DateTime?       @map("completed_at")
  skippedAt       DateTime?       @map("skipped_at")
  skipReason      String?         @map("skip_reason") @db.VarChar(500)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  application SaasApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  tasks       ApplicationTask[]
  blockers    ApplicationBlocker[]

  @@index([applicationId, position])
  @@index([applicationId, status])
  @@index([applicationId, dueAt])
  @@map("application_milestones")
}

model ApplicationTask {
  id             String                @id @default(uuid()) @db.Uuid
  milestoneId    String                @map("milestone_id") @db.Uuid
  assigneeUserId String?               @map("assignee_user_id") @db.Uuid
  title          String                @db.VarChar(200)
  description    String?               @db.Text
  status         ApplicationTaskStatus @default(TODO)
  priority       WorkItemPriority      @default(MEDIUM)
  weight         Int                   @default(1)
  position       Int                   @default(0)
  dueAt          DateTime?             @map("due_at")
  completedAt    DateTime?             @map("completed_at")
  skippedAt      DateTime?             @map("skipped_at")
  skipReason     String?               @map("skip_reason") @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  milestone ApplicationMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignee  User?                @relation("ApplicationTaskAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  blockers  ApplicationBlocker[]

  @@index([milestoneId, position])
  @@index([milestoneId, status])
  @@index([assigneeUserId])
  @@index([dueAt, status])
  @@map("application_tasks")
}

model ApplicationBlocker {
  id               String           @id @default(uuid()) @db.Uuid
  applicationId    String           @map("application_id") @db.Uuid
  milestoneId      String?          @map("milestone_id") @db.Uuid
  taskId           String?          @map("task_id") @db.Uuid
  createdByUserId  String?          @map("created_by_user_id") @db.Uuid
  resolvedByUserId String?          @map("resolved_by_user_id") @db.Uuid
  title            String           @db.VarChar(200)
  description      String?          @db.Text
  severity         WorkItemPriority @default(HIGH)
  status           BlockerStatus    @default(OPEN)
  openedAt         DateTime         @default(now()) @map("opened_at")
  resolvedAt       DateTime?        @map("resolved_at")
  resolution       String?          @db.Text
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  application SaasApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  milestone   ApplicationMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  task        ApplicationTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdBy  User? @relation("ApplicationBlockerCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ApplicationBlockerResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, status])
  @@index([applicationId, severity])
  @@index([milestoneId])
  @@index([taskId])
  @@index([openedAt])
  @@map("application_blockers")
}

model Website {
  id                   String    @id @default(uuid()) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  applicationId        String?   @map("application_id") @db.Uuid
  name                 String    @db.VarChar(160)
  domain               String    @db.VarChar(253)
  timeZone             String    @default("UTC") @map("time_zone") @db.VarChar(64)
  enabled              Boolean   @default(true)
  allowedOrigins       String[]  @default([]) @map("allowed_origins")
  trackingKeyPrefix    String    @unique @map("tracking_key_prefix") @db.VarChar(32)
  trackingKeyHash      String    @unique @map("tracking_key_hash") @db.VarChar(64)
  trackingKeyRotatedAt DateTime  @default(now()) @map("tracking_key_rotated_at")
  lastEventAt          DateTime? @map("last_event_at")
  archivedAt           DateTime? @map("archived_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  workspace                Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application              SaasApplication?           @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  rawEvents                RawAnalyticsEvent[]
  analyticsVisitors        AnalyticsVisitor[]
  analyticsSessions        AnalyticsSession[]
  analyticsEvents          AnalyticsEvent[]
  analyticsPageViews       AnalyticsPageView[]
  hourlyAggregates         AnalyticsHourlyAggregate[]
  dailyAggregates          AnalyticsDailyAggregate[]
  analyticsProcessingRuns  AnalyticsProcessingRun[]
  analyticsProcessingState AnalyticsProcessingState?

  @@unique([workspaceId, domain])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, enabled])
  @@index([workspaceId, applicationId])
  @@index([applicationId])
  @@index([lastEventAt])
  @@map("websites")
}

model AnalyticsVisitor {
  id                String   @id @default(uuid()) @db.Uuid
  websiteId         String   @map("website_id") @db.Uuid
  externalVisitorId String   @map("external_visitor_id") @db.VarChar(80)
  firstSeenAt       DateTime @map("first_seen_at")
  lastSeenAt        DateTime @map("last_seen_at")
  sessionCount      Int      @default(0) @map("session_count")
  pageViewCount     Int      @default(0) @map("page_view_count")
  eventCount        Int      @default(0) @map("event_count")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  website   Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sessions  AnalyticsSession[]
  events    AnalyticsEvent[]
  pageViews AnalyticsPageView[]

  @@unique([websiteId, externalVisitorId])
  @@index([websiteId, firstSeenAt])
  @@index([websiteId, lastSeenAt])
  @@map("analytics_visitors")
}

model AnalyticsSession {
  id                     String              @id @default(uuid()) @db.Uuid
  websiteId              String              @map("website_id") @db.Uuid
  visitorId              String              @map("visitor_id") @db.Uuid
  externalSessionId      String              @map("external_session_id") @db.VarChar(80)
  startedAt              DateTime            @map("started_at")
  endedAt                DateTime            @map("ended_at")
  lastEventAt            DateTime            @map("last_event_at")
  durationMs             Int                 @default(0) @map("duration_ms")
  engagedDurationMs      Int                 @default(0) @map("engaged_duration_ms")
  pageViewCount          Int                 @default(0) @map("page_view_count")
  eventCount             Int                 @default(0) @map("event_count")
  customEventCount       Int                 @default(0) @map("custom_event_count")
  bounced                Boolean             @default(true)
  entryPath              String?             @map("entry_path") @db.VarChar(2048)
  exitPath               String?             @map("exit_path") @db.VarChar(2048)
  entryTitle             String?             @map("entry_title") @db.VarChar(512)
  exitTitle              String?             @map("exit_title") @db.VarChar(512)
  referrerUrl            String?             @map("referrer_url") @db.VarChar(2048)
  sourceType             AnalyticsSourceType @default(UNKNOWN) @map("source_type")
  sourceName             String              @default("Unknown") @map("source_name") @db.VarChar(160)
  sourceDomain           String?             @map("source_domain") @db.VarChar(253)
  countryCode            String?             @map("country_code") @db.Char(2)
  deviceType             AnalyticsDeviceType @default(OTHER) @map("device_type")
  browserName            String              @default("Unknown") @map("browser_name") @db.VarChar(100)
  browserVersion         String?             @map("browser_version") @db.VarChar(50)
  operatingSystem        String              @default("Unknown") @map("operating_system") @db.VarChar(100)
  operatingSystemVersion String?             @map("operating_system_version") @db.VarChar(50)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  website   Website             @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor   AnalyticsVisitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  events    AnalyticsEvent[]
  pageViews AnalyticsPageView[]

  @@unique([websiteId, externalSessionId])
  @@index([websiteId, startedAt])
  @@index([websiteId, endedAt])
  @@index([websiteId, bounced, startedAt])
  @@index([websiteId, sourceType, startedAt])
  @@index([websiteId, countryCode, startedAt])
  @@index([websiteId, deviceType, startedAt])
  @@index([visitorId, startedAt])
  @@map("analytics_sessions")
}

model AnalyticsEvent {
  id                     String                @id @default(uuid()) @db.Uuid
  websiteId              String                @map("website_id") @db.Uuid
  visitorId              String                @map("visitor_id") @db.Uuid
  sessionId              String                @map("session_id") @db.Uuid
  rawEventId             String?               @unique @map("raw_event_id") @db.Uuid
  sourceEventId          String                @map("source_event_id") @db.VarChar(80)
  type                   RawAnalyticsEventType
  eventName              String?               @map("event_name") @db.VarChar(100)
  occurredAt             DateTime              @map("occurred_at")
  receivedAt             DateTime              @map("received_at")
  pageUrl                String                @map("page_url") @db.VarChar(2048)
  normalizedPath         String                @map("normalized_path") @db.VarChar(2048)
  pageTitle              String?               @map("page_title") @db.VarChar(512)
  referrerUrl            String?               @map("referrer_url") @db.VarChar(2048)
  properties             Json?
  durationMs             Int?                  @map("duration_ms")
  sourceType             AnalyticsSourceType   @default(UNKNOWN) @map("source_type")
  sourceName             String                @default("Unknown") @map("source_name") @db.VarChar(160)
  sourceDomain           String?               @map("source_domain") @db.VarChar(253)
  countryCode            String?               @map("country_code") @db.Char(2)
  deviceType             AnalyticsDeviceType   @default(OTHER) @map("device_type")
  browserName            String                @default("Unknown") @map("browser_name") @db.VarChar(100)
  browserVersion         String?               @map("browser_version") @db.VarChar(50)
  operatingSystem        String                @default("Unknown") @map("operating_system") @db.VarChar(100)
  operatingSystemVersion String?               @map("operating_system_version") @db.VarChar(50)
  processedAt            DateTime              @default(now()) @map("processed_at")

  website  Website            @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor  AnalyticsVisitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session  AnalyticsSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawEvent RawAnalyticsEvent? @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  pageView AnalyticsPageView?

  @@unique([websiteId, sourceEventId])
  @@index([websiteId, occurredAt])
  @@index([websiteId, type, occurredAt])
  @@index([websiteId, eventName, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([visitorId, occurredAt])
  @@map("analytics_events")
}

model AnalyticsPageView {
  id               String              @id @default(uuid()) @db.Uuid
  websiteId        String              @map("website_id") @db.Uuid
  visitorId        String              @map("visitor_id") @db.Uuid
  sessionId        String              @map("session_id") @db.Uuid
  analyticsEventId String              @unique @map("analytics_event_id") @db.Uuid
  occurredAt       DateTime            @map("occurred_at")
  pageUrl          String              @map("page_url") @db.VarChar(2048)
  normalizedPath   String              @map("normalized_path") @db.VarChar(2048)
  title            String?             @db.VarChar(512)
  referrerUrl      String?             @map("referrer_url") @db.VarChar(2048)
  sourceType       AnalyticsSourceType @default(UNKNOWN) @map("source_type")
  sourceName       String              @default("Unknown") @map("source_name") @db.VarChar(160)
  sourceDomain     String?             @map("source_domain") @db.VarChar(253)
  countryCode      String?             @map("country_code") @db.Char(2)
  deviceType       AnalyticsDeviceType @default(OTHER) @map("device_type")
  browserName      String              @default("Unknown") @map("browser_name") @db.VarChar(100)
  operatingSystem  String              @default("Unknown") @map("operating_system") @db.VarChar(100)
  isEntry          Boolean             @default(false) @map("is_entry")
  isExit           Boolean             @default(false) @map("is_exit")
  createdAt        DateTime            @default(now()) @map("created_at")

  website Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  event   AnalyticsEvent   @relation(fields: [analyticsEventId], references: [id], onDelete: Cascade)

  @@index([websiteId, occurredAt])
  @@index([websiteId, normalizedPath, occurredAt])
  @@index([websiteId, sourceType, occurredAt])
  @@index([websiteId, countryCode, occurredAt])
  @@index([sessionId, occurredAt])
  @@map("analytics_page_views")
}

model AnalyticsHourlyAggregate {
  id              String                      @id @default(uuid()) @db.Uuid
  websiteId       String                      @map("website_id") @db.Uuid
  bucketStart     DateTime                    @map("bucket_start")
  bucketEnd       DateTime                    @map("bucket_end")
  timeZone        String                      @map("time_zone") @db.VarChar(64)
  dimension       AnalyticsAggregateDimension
  dimensionKey    String                      @map("dimension_key") @db.VarChar(64)
  dimensionValue  String                      @map("dimension_value") @db.VarChar(2048)
  dimensionLabel  String                      @map("dimension_label") @db.VarChar(256)
  visitors        Int                         @default(0)
  sessions        Int                         @default(0)
  pageViews       Int                         @default(0) @map("page_views")
  events          Int                         @default(0)
  customEvents    Int                         @default(0) @map("custom_events")
  bounces         Int                         @default(0)
  totalDurationMs BigInt                      @default(0) @map("total_duration_ms")
  generatedAt     DateTime                    @default(now()) @map("generated_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, bucketStart, dimension, dimensionKey])
  @@index([websiteId, dimension, bucketStart])
  @@index([websiteId, bucketStart])
  @@map("analytics_hourly_aggregates")
}

model AnalyticsDailyAggregate {
  id              String                      @id @default(uuid()) @db.Uuid
  websiteId       String                      @map("website_id") @db.Uuid
  bucketStart     DateTime                    @map("bucket_start")
  bucketEnd       DateTime                    @map("bucket_end")
  timeZone        String                      @map("time_zone") @db.VarChar(64)
  dimension       AnalyticsAggregateDimension
  dimensionKey    String                      @map("dimension_key") @db.VarChar(64)
  dimensionValue  String                      @map("dimension_value") @db.VarChar(2048)
  dimensionLabel  String                      @map("dimension_label") @db.VarChar(256)
  visitors        Int                         @default(0)
  sessions        Int                         @default(0)
  pageViews       Int                         @default(0) @map("page_views")
  events          Int                         @default(0)
  customEvents    Int                         @default(0) @map("custom_events")
  bounces         Int                         @default(0)
  totalDurationMs BigInt                      @default(0) @map("total_duration_ms")
  generatedAt     DateTime                    @default(now()) @map("generated_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, bucketStart, dimension, dimensionKey])
  @@index([websiteId, dimension, bucketStart])
  @@index([websiteId, bucketStart])
  @@map("analytics_daily_aggregates")
}

model AnalyticsProcessingState {
  websiteId               String                    @id @map("website_id") @db.Uuid
  status                  AnalyticsProcessingStatus @default(COMPLETED)
  lastStartedAt           DateTime?                 @map("last_started_at")
  lastCompletedAt         DateTime?                 @map("last_completed_at")
  lastFailedAt            DateTime?                 @map("last_failed_at")
  lastProcessedReceivedAt DateTime?                 @map("last_processed_received_at")
  lastError               String?                   @map("last_error") @db.Text
  totalRawEventsProcessed BigInt                    @default(0) @map("total_raw_events_processed")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("analytics_processing_states")
}

model AnalyticsProcessingRun {
  id                 String                    @id @default(uuid()) @db.Uuid
  websiteId          String                    @map("website_id") @db.Uuid
  initiatedByUserId  String?                   @map("initiated_by_user_id") @db.Uuid
  status             AnalyticsProcessingStatus @default(RUNNING)
  rawEventsProcessed Int                       @default(0) @map("raw_events_processed")
  sessionsRebuilt    Int                       @default(0) @map("sessions_rebuilt")
  hourlyBuckets      Int                       @default(0) @map("hourly_buckets")
  dailyBuckets       Int                       @default(0) @map("daily_buckets")
  startedAt          DateTime                  @default(now()) @map("started_at")
  completedAt        DateTime?                 @map("completed_at")
  failedAt           DateTime?                 @map("failed_at")
  errorMessage       String?                   @map("error_message") @db.Text

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, startedAt])
  @@index([status, startedAt])
  @@map("analytics_processing_runs")
}

model RawAnalyticsEvent {
  id             String                @id @default(uuid()) @db.Uuid
  websiteId      String                @map("website_id") @db.Uuid
  eventId        String                @map("event_id") @db.VarChar(80)
  type           RawAnalyticsEventType
  visitorId      String                @map("visitor_id") @db.VarChar(80)
  sessionId      String                @map("session_id") @db.VarChar(80)
  occurredAt     DateTime              @map("occurred_at")
  receivedAt     DateTime              @default(now()) @map("received_at")
  pageUrl        String                @map("page_url") @db.VarChar(2048)
  pagePath       String                @map("page_path") @db.VarChar(2048)
  pageTitle      String?               @map("page_title") @db.VarChar(512)
  referrerUrl    String?               @map("referrer_url") @db.VarChar(2048)
  eventName      String?               @map("event_name") @db.VarChar(100)
  properties     Json?
  screenWidth    Int?                  @map("screen_width")
  screenHeight   Int?                  @map("screen_height")
  viewportWidth  Int?                  @map("viewport_width")
  viewportHeight Int?                  @map("viewport_height")
  language       String?               @db.VarChar(35)
  clientTimeZone String?               @map("client_time_zone") @db.VarChar(64)
  durationMs     Int?                  @map("duration_ms")
  origin         String                @db.VarChar(512)
  userAgent      String?               @map("user_agent") @db.VarChar(512)
  ipHash         String?               @map("ip_hash") @db.VarChar(64)
  sdkVersion     String                @map("sdk_version") @db.VarChar(32)

  website        Website         @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  analyticsEvent AnalyticsEvent?

  @@unique([websiteId, eventId])
  @@index([websiteId, receivedAt])
  @@index([websiteId, occurredAt])
  @@index([websiteId, type, occurredAt])
  @@index([websiteId, visitorId, occurredAt])
  @@index([websiteId, sessionId, occurredAt])
  @@index([eventName])
  @@map("raw_analytics_events")
}

