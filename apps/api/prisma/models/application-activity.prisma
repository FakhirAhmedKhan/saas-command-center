model ApplicationActivity {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  applicationId   String?                 @map("application_id") @db.Uuid
  applicationName String                  @map("application_name") @db.VarChar(160)
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  actorType       ActivityActorType       @default(USER) @map("actor_type")
  activityType    ApplicationActivityType @map("activity_type")
  entityType      ActivityEntityType      @map("entity_type")
  entityId        String?                 @map("entity_id") @db.Uuid
  title           String                  @db.VarChar(180)
  description     String?                 @db.VarChar(500)
  metadata        Json?
  createdAt       DateTime                @default(now()) @map("created_at")

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  application SaasApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  actor       User?            @relation("ApplicationActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([workspaceId, activityType, createdAt])
  @@index([workspaceId, entityType, createdAt])
  @@map("application_activities")
}
