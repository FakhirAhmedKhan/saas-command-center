NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://command_center:command_center@127.0.0.1:5433/command_center?schema=public

JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

TRUST_PROXY=false

COOKIE_NAME=command_center_refresh_token
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=2592000000

BODY_LIMIT=1mb
SWAGGER_ENABLED=true
APP_VERSION=0.1.0

REDIS_URL=redis://127.0.0.1:6379

ANALYTICS_WORKER_ENABLED=true
ANALYTICS_WORKER_INTERVAL_MS=5000
ANALYTICS_SCHEDULER_ENABLED=true

ANALYTICS_MAX_RETRIES=3
ANALYTICS_REPROCESS_MAX_DAYS=31
ANALYTICS_PROCESSING_TIMEOUT_MS=120000

ANALYTICS_INGESTION_LIMIT=120
ANALYTICS_INGESTION_WINDOW_SECONDS=60

HEALTH_MONITOR_ENABLED=true

HEALTH_MONITOR_BATCH_SIZE=20
HEALTH_MONITOR_CONCURRENCY=5

HEALTH_MIN_INTERVAL_SECONDS=60
HEALTH_MAX_INTERVAL_SECONDS=86400

HEALTH_MIN_TIMEOUT_MS=1000
HEALTH_MAX_TIMEOUT_MS=30000

HEALTH_HISTORY_RETENTION_DAYS=30
HEALTH_DEFAULT_FAILURE_THRESHOLD=3

INVITATION_TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters
INVITATION_TTL_HOURS=72

INVITATION_EMAIL_ENABLED=false

NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_CLEANUP_ENABLED=true

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WEBHOOK_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

WEBHOOK_WORKER_ENABLED=true
WEBHOOK_WORKER_BATCH_SIZE=20
WEBHOOK_WORKER_CONCURRENCY=5
WEBHOOK_PROCESSING_TIMEOUT_MS=120000

WEBHOOK_DEFAULT_TIMEOUT_MS=10000
WEBHOOK_MAX_TIMEOUT_MS=30000

WEBHOOK_DEFAULT_MAX_ATTEMPTS=5
WEBHOOK_MAX_ATTEMPTS=8

WEBHOOK_RETENTION_DAYS=90
WEBHOOK_CLEANUP_ENABLED=true