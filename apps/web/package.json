{
  "name": "@command-center/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:e2e:headed": "playwright test --config=playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=playwright.config.ts --debug",
    "test:e2e:list": "playwright test --config=playwright.config.ts --list",
    "test:phase4": "pnpm typecheck && pnpm build",
    "test:e2e:batch10": "playwright test --config=playwright.config.ts e2e/batch10",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@command-center/shared-types": "workspace:*",
    "@command-center/ui": "workspace:*",
    "@monaco-editor/react": "4.8.0-rc.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "next": "16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@command-center/eslint-config": "workspace:*",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.34.0",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0"
  }
}
