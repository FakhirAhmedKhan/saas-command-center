NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_TRACKER_SCRIPT_URL=http://localhost:3002/tracker.js

# The tracker installation snippet's collect endpoint. Normally
# `${NEXT_PUBLIC_API_URL}/collect`, but kept independently configurable in
# case analytics ingestion is ever served from a different host/CDN.
NEXT_PUBLIC_INGESTION_URL=http://localhost:4000/api/v1/collect

# All NEXT_PUBLIC_* variables above fall back to a localhost default if
# unset, which is convenient for local dev but means a missing value in
# Vercel fails SILENTLY in production (the app calls localhost from the
# user's browser instead of erroring at build time). Always set these
# explicitly in every Vercel environment (Production, Preview, Staging).