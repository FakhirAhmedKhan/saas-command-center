import { describe, expect, it } from 'vitest';

import { DESKTOP_ARCHITECTURE_LABELS, DESKTOP_FRAMEWORK_LABELS, DESKTOP_PLATFORM_LABELS } from '@/features/desktop-apps/desktop-app.constants';

import { getDesktopFrameworksForPlatform, getDesktopPrimaryIdentifier, isDesktopFrameworkAllowed } from '@/features/desktop-apps/desktop-app-utils';

describe('desktop app foundation', () => {
  it('provides readable platform labels', () => {
    expect(DESKTOP_PLATFORM_LABELS.WINDOWS).toBe('Windows');

    expect(DESKTOP_PLATFORM_LABELS.MACOS).toBe('macOS');

    expect(DESKTOP_PLATFORM_LABELS.LINUX).toBe('Linux');

    expect(DESKTOP_PLATFORM_LABELS.CROSS_PLATFORM).toBe('Cross-platform');
  });

  it('provides readable framework labels', () => {
    expect(DESKTOP_FRAMEWORK_LABELS.ELECTRON).toBe('Electron');

    expect(DESKTOP_FRAMEWORK_LABELS.TAURI).toBe('Tauri');

    expect(DESKTOP_FRAMEWORK_LABELS.DOTNET).toBe('.NET');

    expect(DESKTOP_FRAMEWORK_LABELS.NATIVE_MACOS).toBe('Native macOS');
  });

  it('provides architecture labels', () => {
    expect(DESKTOP_ARCHITECTURE_LABELS.X64).toBe('x64');

    expect(DESKTOP_ARCHITECTURE_LABELS.ARM64).toBe('ARM64');

    expect(DESKTOP_ARCHITECTURE_LABELS.UNIVERSAL).toBe('Universal');
  });

  it('allows native Windows only for Windows', () => {
    expect(isDesktopFrameworkAllowed('WINDOWS', 'NATIVE_WINDOWS')).toBe(true);

    expect(isDesktopFrameworkAllowed('MACOS', 'NATIVE_WINDOWS')).toBe(false);
  });

  it('allows native macOS only for macOS', () => {
    expect(isDesktopFrameworkAllowed('MACOS', 'NATIVE_MACOS')).toBe(true);

    expect(isDesktopFrameworkAllowed('WINDOWS', 'NATIVE_MACOS')).toBe(false);
  });

  it('supports Electron for cross-platform applications', () => {
    expect(getDesktopFrameworksForPlatform('CROSS_PLATFORM')).toContain('ELECTRON');
  });

  it('returns package name as the primary identifier', () => {
    expect(getDesktopPrimaryIdentifier({ packageName: 'com.commandcenter.desktop' } as Parameters<typeof getDesktopPrimaryIdentifier>[0])).toBe(
      'com.commandcenter.desktop',
    );
  });

  it('returns fallback when package name is missing', () => {
    expect(getDesktopPrimaryIdentifier({ packageName: null } as Parameters<typeof getDesktopPrimaryIdentifier>[0])).toBe('No package name');
  });
});
