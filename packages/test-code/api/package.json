{
  "name": "@command-center/api-tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node scripts/run-jest.mjs --config ../../packages/test-code/api/jest.config.cjs --runInBand",
    "test:e2e": "node scripts/run-e2e-isolated.mjs",
    "test": "pnpm run test:unit \u0026\u0026 pnpm run test:e2e",
    "test:e2e:fast": "node scripts/run-jest.mjs --config ../../packages/test-code/api/jest-e2e.config.cjs --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@command-center/eslint-config": "workspace:*",
    "globals": "^17.11.0"
  }
}
