    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.20.3",
    "@types/supertest": "^6.0.3",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jest": "29.7.0",
    "pg": "^8.23.0",
    "supertest": "^7.1.4",
    "ts-jest": "29.4.12",
    "typescript": "^5.9.2"
  }
