  "private": true,
  "scripts": {
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "pretest:e2e": "pnpm --dir ../../../apps/api exec node -e \"require('dotenv').config({path:'.env.test',override:true,quiet:true});const{spawnSync}=require('node:child_process');const r=spawnSync('pnpm',['exec','prisma','migrate','deploy'],{stdio:'inherit',env:process.env,shell:true});process.exit(r.status??1)\"",
